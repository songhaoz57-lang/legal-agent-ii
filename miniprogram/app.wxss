/* 全局样式 */
page {
  background: #f0f2f5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1a1a2e;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}
.btn-primary:active { opacity: 0.85; }

.btn-secondary {
  background: #f3f4f6;
  color: #374151;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 页面标题 */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.tag-red { background: #fef2f2; color: #dc2626; }
.tag-yellow { background: #fffbeb; color: #d97706; }
.tag-green { background: #ecfdf5; color: #059669; }
.tag-blue { background: #eff6ff; color: #2563eb; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: #9ca3af;
}
.empty-state .icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-state .text { font-size: 28rpx; }

/* 加载中 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
}
