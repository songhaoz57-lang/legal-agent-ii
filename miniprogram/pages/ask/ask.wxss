.chat-scroll {
  height: calc(100vh - 120rpx);
  padding: 16rpx 24rpx;
}
.msg-list { padding-bottom: 20rpx; }

.msg-ai, .msg-user {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg-user { justify-content: flex-end; }

.msg-avatar {
  width: 60rpx; height: 60rpx;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700;
  margin-right: 16rpx; flex-shrink: 0;
}

.msg-bubble {
  max-width: 80%;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}
.ai-bubble { background: #fff; border: 1rpx solid #e5e7eb; color: #1a1a2e; }
.user-bubble { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; }

.hints { margin-top: 32rpx; width: 100%; }
.hint-item {
  background: #fff; padding: 20rpx 24rpx; border-radius: 12rpx;
  margin-bottom: 12rpx; font-size: 26rpx; color: #4f46e5;
  border: 1rpx solid #e0e7ff;
}
.hint-item:active { background: #eef2ff; }

.chat-input-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff; border-top: 1rpx solid #e5e7eb;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04);
}
.chat-input {
  flex: 1; height: 72rpx;
  background: #f3f4f6; border-radius: 36rpx;
  padding: 0 28rpx; font-size: 28rpx;
}
.send-btn {
  width: 120rpx; height: 72rpx;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff; border-radius: 36rpx;
  font-size: 26rpx; line-height: 72rpx;
  padding: 0; border: none; text-align: center;
}
.send-btn[disabled] { opacity: 0.4; }

.empty-state .icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-state .text { font-size: 28rpx; color: #9ca3af; }
