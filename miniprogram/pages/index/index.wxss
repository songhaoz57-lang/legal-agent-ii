.upload-card {
  text-align: center;
  padding: 60rpx 32rpx;
  border: 4rpx dashed #d1d5db;
  background: #fafbfc;
  border-radius: 20rpx;
  margin: 24rpx;
  transition: all 0.2s;
}
.upload-card:active { border-color: #4f46e5; background: #eef2ff; }

.upload-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.upload-title { font-size: 30rpx; color: #374151; font-weight: 500; }
.upload-hint { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; }
.upload-file { margin-top: 16rpx; font-size: 26rpx; color: #4f46e5; background: #eef2ff; padding: 12rpx 24rpx; border-radius: 8rpx; display: inline-block; }

.result-card { margin-top: 0; }
.card-header { margin-bottom: 24rpx; }
.card-title { font-size: 32rpx; font-weight: 600; }

.score-section { display: flex; align-items: center; gap: 20rpx; margin-bottom: 32rpx; }
.score-label { font-size: 26rpx; color: #6b7280; white-space: nowrap; }
.score-bar-bg { flex: 1; height: 16rpx; background: #e5e7eb; border-radius: 8rpx; overflow: hidden; }
.score-bar-fill { height: 100%; border-radius: 8rpx; transition: width 0.5s; }
.score-bar-fill.high { background: #ef4444; }
.score-bar-fill.mid { background: #f59e0b; }
.score-bar-fill.low { background: #10b981; }
.score-num { font-size: 32rpx; font-weight: 700; }
.score-num.high { color: #ef4444; }
.score-num.mid { color: #f59e0b; }
.score-num.low { color: #10b981; }

.section { margin-top: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #374151; margin-bottom: 16rpx; }

.risk-item { background: #f9fafb; border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx; }
.risk-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; margin-bottom: 8rpx; display: inline-block; }
.risk-tag.high { background: #fef2f2; color: #dc2626; }
.risk-tag.mid { background: #fffbeb; color: #d97706; }
.risk-tag.low { background: #ecfdf5; color: #059669; }
.risk-clause { font-size: 28rpx; font-weight: 500; margin: 8rpx 0; }
.risk-desc { font-size: 24rpx; color: #6b7280; }

.missing-item { font-size: 26rpx; color: #f59e0b; padding: 12rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.missing-item:last-child { border-bottom: none; }
