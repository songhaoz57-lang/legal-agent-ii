.search-bar { padding: 16rpx 24rpx; }
.search-input {
  width: 100%; height: 72rpx;
  background: #fff; border-radius: 36rpx;
  padding: 0 32rpx; font-size: 28rpx;
  border: 1rpx solid #e5e7eb;
}

.cat-scroll { white-space: nowrap; padding: 8rpx 24rpx 16rpx; }
.cat-tag {
  display: inline-block; padding: 12rpx 28rpx;
  background: #fff; border-radius: 32rpx;
  font-size: 26rpx; color: #6b7280;
  margin-right: 12rpx; border: 1rpx solid #e5e7eb;
}
.cat-tag.active { background: #4f46e5; color: #fff; border-color: #4f46e5; }

.source-list { padding: 0 24rpx; }
.source-item {
  background: #fff; border-radius: 16rpx;
  padding: 28rpx 32rpx; margin-bottom: 12rpx;
  border: 1rpx solid #f3f4f6;
}
.source-item:active { background: #f9fafb; }

.source-title { font-size: 30rpx; font-weight: 500; color: #1a1a2e; }
.source-meta { margin-top: 8rpx; }
.source-cat { font-size: 24rpx; color: #9ca3af; }
